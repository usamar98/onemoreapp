{
  "name": "chapter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "jobs:work": "tsx --env-file-if-exists=.env.local scripts/jobs-worker.ts",
    "chapter:cli": "node --env-file-if-exists=.env.local public/chapter-cli.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/security.test.ts tests/vercel.test.ts tests/cloud.test.ts tests/phase-two.test.ts tests/phase-three.test.ts tests/phase-four.test.ts tests/phase-five.test.ts tests/phase-six.test.ts tests/operator-backup.test.ts tests/site-pricing.test.ts tests/quick-publish.test.ts",
    "cloud:check": "tsx --env-file=.env.local scripts/cloud-check.ts",
    "cloud:migrate": "tsx --env-file=.env.local scripts/cloud-migrate.ts",
    "backup:local": "tsx --env-file-if-exists=.env.local scripts/operator-backup.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests playwright.config.ts next.config.ts package.json tsconfig.json"
  },
  "dependencies": {
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/inter": "^5.2.0",
    "@supabase/supabase-js": "2.95.3",
    "@vercel/sandbox": "2.9.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "parse5": "^8.0.1",
    "postgres": "3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stripe": "23.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
