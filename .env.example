# Optional server configuration. Copy to .env.local, which is ignored.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production SEO origin, independent from the local app URL. Defaults to the requested domain.
NEXT_PUBLIC_SITE_URL=https://onemoreapp.pro
# Configure through secure key setup. Never use a NEXT_PUBLIC_ variable for a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Use an absolute persistent directory in production. Defaults to .data/.
# CHAPTER_DATA_DIR=/var/lib/chapter
# Set true behind HTTPS in production.
COOKIE_SECURE=false
# Vercel requires cloud persistence; local SQLite remains the default outside Vercel.
# Use your Supabase transaction pooler URL (port 6543) with the postgres role.
DATABASE_URL=
SUPABASE_URL=
# Supabase secret key (or legacy service_role key): server only.
SUPABASE_SECRET_KEY=
# Generate a base64-encoded 32-byte key once, and retain it across deployments.
CHAPTER_ENCRYPTION_KEY=
# Optional revival and Phase Six isolated build checks. Use Vercel OIDC on a linked deployment, or
# all three server-only variables below. Never forward these into project builds.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
# Phase Three: Stripe remains unavailable until these server-only settings are configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_TEAM_PRICE_ID=
# Optional JSON overrides, for example {"Free":{"projects":10,"seats":2}}
CHAPTER_PLAN_LIMITS=
# Set a random secret of at least 32 characters for the authenticated Vercel cron.
CRON_SECRET=
# Phase Four: optional human support contact. Support references are always private.
SUPPORT_EMAIL=
# Operator backups: private passphrase, never commit or pass it as a CLI argument.
CHAPTER_BACKUP_PASSWORD=
# Platform administrators are registered user IDs, never client-editable roles.
# Separate multiple trusted database user IDs with commas. Disabled by default.
CHAPTER_ADMIN_USER_IDS=
